  .product-tab .owl-nav {
    position: absolute;
    top: 37%;
    width: 100%;
    flex: none;
    margin-top: 0;
  }
  .product-tab button.owl-prev {
    position: absolute;
    border: 1px solid #ccc;
    color: #777;
    background-color: #fff;
    border-radius: 50%;
    width: 40px;
    left: -15px;
  }
  .product-tab button.owl-next {
    display: block;
    float: right;
    border: 1px solid #ccc;
    color: #777;
    background-color: #fff;
    border-radius: 50%;
    width: 40px;
    position: absolute;
    right: -15px;
  }

  .experience-wrapper h4 {
    font-size: 18px !important;
    line-height: 22px !important;
    font-family: "Proxima Nova";
    margin-bottom: 12px;
    margin-top: 24px;
    color: #ffffff;
  }
  .experience-wrapper p {
    font-size: 15px;
    line-height: 22.5px;
    color: #ffffff;
    margin-bottom: 0 !important;
  }
  .experience-wrapper h2 {
    color: #ffffff;
    margin-bottom: 0 !important;
  }
  .product-title-wrap {
    padding-left: 10px;
    padding-right: 10px;
  }
  .products.wrapper.grid.products-grid {
    margin-bottom: 0;
  }
  .product-tab-wrapper .product-item-details {
    padding: 24px 0 0 0;
  }
  .products-grid:not(.side-list):not(.products-related)
    .owl-carousel
    .product-item {
    padding: 0;
  }
  .featured_product hr {
    margin-top: 40px;
    margin-bottom: 24px;
    border-top: 1px solid #ebecf0;
  }
  .featured_product .product-item-details {
    padding: 24px 0 0 0;
  }

  .half-color-bar {
    background: linear-gradient(#ffffff 50%, #f2eadf 50%);
  }
  .half-color-bar2 {
    background: linear-gradient(#f2eadf 50%, #fafafa 50%);
  }
  .half-color-bar img,
  .half-color-bar2 img {
    text-align: center;
    margin: 0 auto;
  }
  .icon-middle-wrap {
    background-color: #f2eadf;
  }
  .icon-middle-wrap .product-title h2 {
    margin-bottom: 0;
  }
  .icon-middle-wrap a.btn.btn-primary {
    margin-top: 24px;
  }

  .icon-middle-wrap h3 {
    font-weight: 700 !important;
  }
  #apparel-lp .owl-carousel .owl-item img {
    width: auto;
  }
  .landing-page .landing-page-banner a.btn.btn-primary {
    background-color: #283e77 !important;
  }
  .landing-page-banner a.btn.btn-primary.btn-white {
    background-color: #ffffff !important;
    color: #283e77;
  }
  #apparel-lp .experience-wrapper {
    background-color: #97b5c7;
  }
  #apparel-lp .services-points .owl-theme .owl-dots .owl-dot.active span {
    background-color: #587789 !important;
  }
</style>

