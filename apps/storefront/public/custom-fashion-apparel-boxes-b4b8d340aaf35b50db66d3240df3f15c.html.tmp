    .product-tab-wrapper button.owl-prev {
      width: 40px;
      height: 40px;
    }
    .product-tab-wrapper button.owl-prev {
      left: -10px;
    }
    .product-tab-wrapper button.owl-next {
      right: -10px;
    }
    .product-tab-wrapper .owl-nav {
      top: 33%;
    }
  }

