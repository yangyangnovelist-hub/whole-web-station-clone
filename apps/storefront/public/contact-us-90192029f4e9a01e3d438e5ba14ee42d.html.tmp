<script src='https://www.google.com/recaptcha/api.js' async defer></script>
<script type="text/javascript">
    
        // Product Data Minimum
        const productData = {
            "Folding Carton Boxes": { min: 1000 },
            "Corrugated Boxes": { min: 500 },
            "Rigid Boxes": { min: 500 },
            "Paper Bags": { min: 1000 },
            "Gusset Bags": { min: 10000 },
            "Stand-up Pouches": { min: 10000 },
            "Kraft Pouches": { min: 10000 },
            "Floor Displays": { min: 100 },
            "Cardboard Inserts": { min: 1000 },
            "Molded Pulp Inserts": { min: 10000 },
            "Cup Sleeves": { min: 10000 },
            "Labels & Stickers": { min: 2000 },
            "Kraft Paper Mailers": { min: 10000 },
            "Poly Mailers": { min: 10000 },
            "Recycled Bubble Mailers": { min: 10000 },
            "Bubble Mailers": { min: 10000 },
            "Packing Tape": { min: 500 },
            "Tissue Paper": { min: 10000 },
            "Food Grade Tissue Paper": { min: 10000 },
            "Other": { min: 0 }
        };

        function productSelected() {
            const selectedProduct = document.getElementById('LEADCF155');
            const selectedValue = selectedProduct.value;
            const messageElement = document.getElementById('minQuantityMessage');
            const quantityInput = document.getElementById('quantityInput');

            // Get minimum quantity based on selected value
            const minQuantity = productData[selectedValue] ? productData[selectedValue].min : 0;

            // Update the input field with the min quantity
            quantityInput.min = minQuantity;
            quantityInput.value = minQuantity; // Reset value to min when changing product

            // Update the message element based on selection
            if (selectedValue) {
                if (minQuantity > 0) {
                    messageElement.textContent = `Minimum quantity for this product is ${minQuantity}.`;
                } else {
                    messageElement.textContent = `While we can accommodate orders below our minimum order quantity (MOQ), we advise against it as the price per unit becomes significantly higher.`;
                }
            } else {
                messageElement.textContent = '';
            }
        }

      // Blur event to revert value if below min
        document.getElementById('quantityInput').addEventListener('blur', function() {
            const quantityInput = this;
            const min = parseInt(quantityInput.min, 10);

            // If the current value is less than the minimum, reset it to the minimum
            if (quantityInput.value < min) {
                quantityInput.value = min; // Set to minimum
                // const messageElement = document.getElementById('minQuantityMessage');
                // messageElement.textContent += ` Reverting to minimum quantity of ${min}.`;
            }
        });

        // Prevent user from typing numbers
        function formatTelInput(evt) {
            // Get the event key code
            const charCode = (evt.which) ? evt.which : evt.keyCode;
            
            // Allow: backspace, delete, tab, escape, enter and specific characters
            if ([8, 9, 27, 13, 40, 38].indexOf(charCode) !== -1 ||
                // Allow: Ctrl+A, Ctrl+C, Ctrl+V
                (charCode === 65 && evt.ctrlKey === true) || 
                (charCode === 67 && evt.ctrlKey === true) || 
                (charCode === 86 && evt.ctrlKey === true) || 
                // Allow: numbers and specific characters (space, parentheses, hyphen)
                (charCode >= 48 && charCode <= 57) || // 0-9
                (charCode >= 96 && charCode <= 105) || // numpad 0-9
                (charCode === 40 || charCode === 41 || charCode === 32 || charCode === 45)) { // ( ) space -
                return true; // allow the keypress
            }
            return false; // block the keypress
        }

        function formatPhoneNumber(input) {
            // Remove all non-digit characters
            let cleaned = ('' + input.value).replace(/\D/g, '');

            // Format the phone number
            let match = cleaned.match(/^(\d{3})(\d{3})(\d{0,4})$/);
            if (match) {
                input.value = `(${match[1]}) ${match[2]}${match[3] ? '-' + match[3] : ''}`;
            } else {
                input.value = cleaned; // If not matched, set to cleaned value
            }
        }
    </script>
<script type="text/javascript">
    require([
        'jquery',
        'js/smart-forms/jquery.validate.min',
        'js/smart-forms/jquery.formShowHide.min',
        'js/smart-forms/additional-methods.min'
    ], function ($) {
        $('.smartfm-ctrl').formShowHide();

        // Initialize form validation
        validate_form();

        $('#reset').on('click', function (e) {
            grecaptcha.reset();
        });

        function validate_form() {
            $("#contact2").validate({
                errorClass: "state-error",
                validClass: "state-success",
                errorElement: "em",
                rules: {
                    'First Name': { required: true },
                    'Last Name': { required: true },
                    LEADCF52: { required: true, min: 1 },
                    LEADCF5: { required: true },
                    LEADCF155: { required: true },
                    LEADCF7: { required: true },
                    services: { required: true },
                    LEADCF4: { required: true },
                    Description: { required: true },
                    Company: { required: false },
                    comment: { required: true, minlength: 30 },
                    Phone: { required: true }
                },
                messages: {
                    'First Name': { required: 'Enter first name' },
                    'Last Name': { required: 'Enter last name' },
                    LEADCF52: { required: 'Quantity needs to be higher than 0' },
                    LEADCF5: { required: 'Please select a service' },
                    LEADCF155: { required: 'Please select a product' },
                    LEADCF7: { required: 'Please select your time frame' },
                    services: { required: 'Please select a service' },
                    LEADCF4: { required: 'Please select a quantity range' },
                    Description: { required: 'Please fill in more detail about your project' },
                    Company: { required: 'Enter your company name' },
                    comment: {
                        required: 'Oops, you forgot to comment',
                        minlength: 'Enter at least 30 characters or more'
                    },
                    Phone: { required: 'Fill a phone contact' }
                },
                highlight: function (element, errorClass, validClass) {
                    $(element).closest('.field').addClass(errorClass).removeClass(validClass);
                },
                unhighlight: function (element, errorClass, validClass) {
                    $(element).closest('.field').removeClass(errorClass).addClass(validClass);
                },
                errorPlacement: function (error, element) {
                    if (element.is(":radio") || element.is(":checkbox")) {
                        element.closest('.option-group').after(error);
                    } else {
                        error.insertAfter(element.parent());
                    }
                }
            });
        }

        $('#contact2').on('submit', function (e) {

   
            if (grecaptcha.getResponse() === "") {
                e.preventDefault();
                $('.g-recaptcha div div').css('border', '1px solid red');
                return; // Early return if reCAPTCHA is not valid
            }

            // Check if the form is valid
            if (!$("#contact2").valid()) {
                e.preventDefault();
                return; // Prevent form submission if validation fails
            }

             // Extract email for the Google Analytics event
             var userEmail = $("#contact2 input[name='Email']").val(); // Adjust the selector for your email input field

            // Send PostHog user email for userID
            posthog.identify(userEmail);

            //Send custom event
           posthog.capture('user_successfully_request_quote')

        });
    });
</script>
