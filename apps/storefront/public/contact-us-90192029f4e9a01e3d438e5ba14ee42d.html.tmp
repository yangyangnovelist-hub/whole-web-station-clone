            <div class="col-md-6 flex">
                <div class="section-leading-des">
                    <div class="icon-group ">
                        <div class="icon-img"><img class="porto-lazyload" loading="lazy"
                                data-src="/media.pakfactory.com/media_upload/coding_guide/customer-company-icons.svg"
                                alt="reviews"></div>
                        <div class="icon-des">Join 3,000+ brands and experience
