<div class="flex-grid-item-option">
<div class="material-box"> <a href="/cold-foil-printing.html"><img class="porto-lazyload" loading='lazy'  data-src="/media.pakfactory.com/media_upload/coding_guide/finishing-7.jpg" alt="Cold Foil Printing">
<div class="material-des">
<h3 class="new-subtitl">Cold Foil Printing</h3>
<p>Form of relief printing in which foil is transferred to a surface by pressing onto UV curable adhesives. </p>
</div>
</a>
</div>
</div>
<div class="flex-grid-item-option">
<div class="material-box"> <a href="/blind-embossing.html"><img class="porto-lazyload" loading='lazy'  data-src="/media.pakfactory.com/media_upload/coding_guide/finishing-11.jpg" alt="Blind Embossing">
<div class="material-des">
