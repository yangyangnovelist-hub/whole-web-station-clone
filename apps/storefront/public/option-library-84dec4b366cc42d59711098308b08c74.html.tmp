    <div class="section-opt">
  <div class="row">
  <div class="col-lg-8">
  <h2 class="top-60">Special Options</h2>
  <p>Additional options to elevate your packaging. </p>
  </div>
  </div>
  
   <hr class="option-hr"> 
  
  <div class="options-items">
  <div class="flex-grid-row-option">
  
  <div class="flex-grid-item-option">
  <div class="material-box"> <a href="/hot-foil-stamping.html"><img class="porto-lazyload" loading='lazy'  data-src="/media.pakfactory.com/media_upload/coding_guide/finishing-6.jpg" alt="Hot Foil Stamping">
  <div class="material-des">
  <h3 class="new-subtitl">Hot Foil Stamping</h3>
  <p>Form of relief printing in which foil is transferred to a surface at high temperatures. </p>
  </div>
  </a>
  </div>
  </div>
  <div class="flex-grid-item-option">
  <div class="material-box"> <a href="/cold-foil-printing.html"><img class="porto-lazyload" loading='lazy'  data-src="/media.pakfactory.com/media_upload/coding_guide/finishing-7.jpg" alt="Cold Foil Printing">
  <div class="material-des">
  <h3 class="new-subtitl">Cold Foil Printing</h3>
  <p>Form of relief printing in which foil is transferred to a surface by pressing onto UV curable adhesives. </p>
  </div>
  </a>
  </div>
  </div>
  <div class="flex-grid-item-option">
  <div class="material-box"> <a href="/blind-embossing.html"><img class="porto-lazyload" loading='lazy'  data-src="/media.pakfactory.com/media_upload/coding_guide/finishing-11.jpg" alt="Blind Embossing">
  <div class="material-des">
  <h3 class="new-subtitl">Blind Embossing</h3>
  <p>Form of relief printing in which dies is pressed on the back of the material to form a raised motif. </p>
  </div>
  </a>
  </div>
