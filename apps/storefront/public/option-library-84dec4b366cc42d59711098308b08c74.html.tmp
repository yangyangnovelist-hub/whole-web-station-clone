    <div class="section-opt">
  <div class="row">
  <div class="col-lg-8">
  <h2 class="top-60">Lamination</h2>
  <p>Laminated films to provide added protection or finish to your packaging. </p>
  </div>
  </div>
  
   <hr class="option-hr"> 
  
  <div class="options-items">
  <div class="flex-grid-row-option">
  
  <div class="flex-grid-item-option">
