  <hr class="my-hr-line">
      <div class="item title" data-role="collapsible">
          <a class="switch" data-toggle="trigger" href="#tab-1"> <img class="porto-lazyload" loading='lazy'  data-src="/media.pakfactory.com/media_upload/coding_guide/layers.svg" alt="Materials" style="width: 22px;" > Materials</a>
      </div>
      <div id="tab-1" class="item content" data-role="content">    
      <div class="section-content">    
    <div class="section-opt">
  <div class="row">
  <div class="col-lg-8">
  <h2 class="no-space-mobile">Paperboard</h2>
  <p>Single-layer paper-based material perfect for all-round use.</p>
  </div>
  </div>
  
   <hr class="option-hr"> 
  
  <div class="options-items">
  <div class="flex-grid-row-option">
  
  <div class="flex-grid-item-option">
  <div class="material-box"> <a href="/solid-bleached-board-c1s.html"><img class="porto-lazyload" loading='lazy'  data-src="/media.pakfactory.com/media_upload/coding_guide/01-c1s.jpg" alt="c1s">
  <div class="material-des">
  <h3 class="new-subtitl">SBS C1S</h3>
  <p>Premium-grade bleached white paperboard coated on one side for high-quality printing and finishes. </p>
    <div class="property">
