	/*table css*/
table th {    color: #000000;    background-color: #F4F5F7;    font-family: 'Proxima Nova';  min-width: 200px; font-weight: 600;}
table td {	color: #727272;}	
table th, table td {	padding: 12px 18px!important;}
table {     border: 1px solid  #DFE1E6;    border-collapse: separate;    border-left: 0;    border-radius: 4px;    border-spacing: 0px;}
thead {    display: table-header-group;    vertical-align: middle;    border-color: inherit;    border-collapse: separate;}
tr {    display: table-row;    vertical-align: inherit;    border-color: inherit;}
th, td {    padding: 5px 4px 6px 4px;     text-align: left;    vertical-align: top;    border-left: 1px solid  #DFE1E6;    }
td {    border-top: 1px solid  #DFE1E6;    }
thead:first-child tr:first-child th:first-child, tbody:first-child tr:first-child td:first-child {    border-radius: 4px 0 0 0;}
thead:last-child tr:last-child th:first-child, tbody:last-child tr:last-child td:first-child {    border-radius: 0 0 0 4px;}
/*end of table css*/	
	
	.space-top-32{margin-top: 32px;}
	.thermo-title{    margin-top: 20px!important; text-align: center; font-weight: 500;}
	
