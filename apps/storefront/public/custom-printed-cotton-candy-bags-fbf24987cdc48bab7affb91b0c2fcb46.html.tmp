      .product-item
      .product-item-info
      a {
      height: 250px;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .featured_product.custom__solution
      .products-grid
      .product-item
      .product-item-info
      a {
      height: 200px;
    }

