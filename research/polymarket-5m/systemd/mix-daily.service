[Unit]
Description=Build one closed UTC day of formal Polymarket MIX evidence
After=network-online.target time-sync.target archive-rec.service strict-artifact-daily.service source-race-daily.service settlement-proxy-daily.service
Wants=network-online.target time-sync.target strict-artifact-daily.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/rec/h-race
Environment=PYTHONPATH=/home/ubuntu/rec/h-race
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=STRICT_SHARED_ROOT=/home/ubuntu/rec/formal/strict-days
Environment=EXPECTED_PROTOCOL_SHA256=31f49eed5d3fdb39afb791ee54f645f59601788921bb336fcc81312699ff3cf4
Environment=EXPECTED_PROJECTION_PROTOCOL_SHA256=51241df6897a0f16e066b69630c286ab83301842418fb9b43cb5e40248f1ef8a
ExecStart=/usr/bin/timeout 3600 /home/ubuntu/rec/venv/bin/python /home/ubuntu/rec/h-race/mix_daily.py
Nice=15
IOSchedulingClass=idle
MemoryMax=4G
TimeoutStartSec=3610s
